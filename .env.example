# Safe local examples - real credentials must never be committed.
#
# Docker Compose reads this file automatically when named ".env" (e.g. `cp .env.example .env`).
# For bare `./gradlew bootRun`, Spring Boot does NOT load .env: export the variables in your shell.

# --- Docker Compose credentials ---
POSTGRES_DB=payment_reminder
POSTGRES_USER=payment_reminder
POSTGRES_PASSWORD=payment_reminder
POSTGRES_DATA_DIR=./.data/postgres

# Telegram (empty values disable delivery and polling)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_POLLING_ENABLED=true
APP_POLLING_DELAY_MS=1000

# Leave empty for production-like scheduling (09:00 daily), or set "local" for instant delivery.
SPRING_PROFILES_ACTIVE=local
APP_TIME_ZONE=Europe/Moscow

# --- Bare run (non-Docker) ---
SERVER_PORT=8080
APP_NOTIFICATION_TIME=09:00
REMINDER_SCHEDULER_CRON="0 0 9 * * *"
APP_PLANNING_CRON="0 0 9 * * *"
APP_DELIVERY_CRON="0 * * * * *"
APP_DELIVERY_LEASE=PT5M
APP_DELIVERY_BATCH=20
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_RETRY_DELAY=PT5M
TELEGRAM_CONNECT_TIMEOUT=PT5S
TELEGRAM_READ_TIMEOUT=PT35S
TELEGRAM_POLLING_TIMEOUT=PT25S
DB_URL=jdbc:postgresql://localhost:5432/payment_reminder
DB_USERNAME=payment_reminder
DB_PASSWORD=payment_reminder
